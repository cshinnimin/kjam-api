<h1 class="games-header">Games</h1>

<div class="game-list">
  <% @games.each do |game| %>
    <%= link_to game_path(game), class: "game-item #{'completed' if game.complete?}" do %>
      <div class="game-meta">
        <small class="game-time"><%= game.game_time.strftime('%A, %l:%M %p') rescue '' %></small>
      </div>

      <div class="team-group">
        <div class="team-entry">
          <span class="team-badge">
            <span class="team-score"><%= (game.home_score_half_1 + game.home_score_half_2) %></span>
            <span class="team-circle" style="background-color: <%= game.home.colour %>"></span>
          </span>
          <span class="team-name"><%= game.home.name %></span>
        </div>
        <div class="vs">vs</div>
        <div class="team-entry away">
          <span class="team-name"><%= game.away.name %></span>
          <span class="team-badge">
            <span class="team-circle" style="background-color: <%= game.away.colour %>"></span>
            <span class="team-score"><%= (game.away_score_half_1 + game.away_score_half_2) %></span>
          </span>
        </div>
      </div>
      
    <% end %>
  <% end %>
</div>
