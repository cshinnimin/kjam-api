<div class="game-show">
  <div class="top-row">
    <div class="team-block">
      <span class="team-circle" style="background-color: <%= @game.home.colour %>"></span>
      <div class="team-name"><%= @game.home.name %></div>
    </div>

    <div class="score-block center-label">&nbsp;</div>

    <div class="team-block">
      <span class="team-circle" style="background-color: <%= @game.away.colour %>"></span>
      <div class="team-name"><%= @game.away.name %></div>
    </div>
  </div>
  <div class="half-row" data-half="1">
    <div class="score-controls home-controls" data-game-id="<%= @game.id %>">
      <button class="score-btn decrement" data-action="decrement-home-one">−</button>
      <div class="score-value" data-home-score><%= @game.home_score_half_1 %></div>
      <button class="score-btn increment" data-action="increment-home-one">+</button>
    </div>

    <div class="half-label">First Half</div>

    <div class="score-controls away-controls" data-game-id="<%= @game.id %>">
      <button class="score-btn decrement" data-action="decrement-away-one">−</button>
      <div class="score-value" data-away-score><%= @game.away_score_half_1 %></div>
      <button class="score-btn increment" data-action="increment-away-one">+</button>
    </div>
  </div>

  <div class="half-row" data-half="2">
    <div class="score-controls home-controls" data-game-id="<%= @game.id %>">
      <button class="score-btn decrement" data-action="decrement-home-two">−</button>
      <div class="score-value" data-home-score><%= @game.home_score_half_2 %></div>
      <button class="score-btn increment" data-action="increment-home-two">+</button>
    </div>

    <div class="half-label">First Half</div>

    <div class="score-controls away-controls" data-game-id="<%= @game.id %>">
      <button class="score-btn decrement" data-action="decrement-away-two">−</button>
      <div class="score-value" data-away-score><%= @game.away_score_half_2 %></div>
      <button class="score-btn increment" data-action="increment-away-two">+</button>
    </div>
  </div>

  <div class="half-row" data-half="total">
    <div class="score-controls home-controls">
      <div class="score-value" data-home-total><%= (@game.home_score_half_1 || 0) + (@game.home_score_half_2 || 0) %></div>
    </div>

    <div class="half-label"><strong>Total Score</strong></div>

    <div class="score-controls away-controls">
      <div class="score-value" data-away-total><%= (@game.away_score_half_1 || 0) + (@game.away_score_half_2 || 0) %></div>
    </div>
  </div>

  <div class="complete-row">
    <div class="complete-label">Complete</div>
    <label class="switch">
      <input type="checkbox" class="complete-toggle" data-game-id="<%= @game.id %>" <%= 'checked' if @game.complete %> />
      <span class="slider"></span>
    </label>
  </div>

  <%= link_to 'Back', games_path, class: 'back-link' %>
</div>
